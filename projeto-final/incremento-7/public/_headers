# Cabeçalhos HTTP que a Cloudflare Pages envia junto com os arquivos.

# Os arquivos de /assets têm um código no nome que muda quando o conteúdo muda,
# então o navegador pode guardá-los por um ano sem perguntar de novo.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Em todas as páginas: não deixa o navegador adivinhar o tipo dos arquivos,
# não deixa outro site mostrar o CombinaCor dentro de um iframe
# e manda só o domínio (sem o caminho) como origem ao sair para outro site.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
